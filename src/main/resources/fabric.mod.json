		"main": [
			"com.lieval.nolimitenchant.NoLimitEnchantMod"
		],
		"client": [
			"com.lieval.nolimitenchant.client.NoLimitEnchantClientMod"
		],
		"modmenu": [
			"com.lieval.nolimitenchant.client.NoLimitEnchantModMenu"
		]
	},
	"mixins": [
